#!/usr/bin/env bash
#
# Restore DB data from a JSON fixture written by tools/db-dump.
#
# With no argument, restores the NEWEST dump in <data-root>/backups/django/ — the
# timestamp format sorts lexically, so "newest" is just the last by name.
# Pass a path to restore a specific dump instead.
#
# Ensure the DB is initialised and empty first, or loaddata collides on primary keys.
#
# Usage:
#   tools/db-load                 # newest dump in the data root
#   tools/db-load <path.json>     # a specific one
#   tools/db-load --list          # what's available, newest first

set -euo pipefail
cd "$(dirname "$0")/.."

# The interpreter. `tools/py` is generated by `jobstudio init` and gitignored,
# because the path is personal to this machine (plan §3.3). $JOBSEARCH_PY overrides it.
PY="${JOBSEARCH_PY:-$(cd "$(dirname "$0")" && pwd)/py}"
if [ ! -x "$PY" ]; then
    echo "tools/py not found. Run \`/jobstudio init\`, or set \$JOBSEARCH_PY." >&2
    exit 1
fi

DATA_ROOT=$("$PY" -c 'import sys; sys.path.insert(0, "src"); import config; print(config.data_root())')
DIR_DB_BACKUP="$DATA_ROOT/backups/django"

if [ "${1:-}" = "--list" ]; then
    echo "Dumps in $DIR_DB_BACKUP (newest first):"
    ls -1 "$DIR_DB_BACKUP"/dump-*.json 2>/dev/null | sort -r || echo "  (none)"
    exit 0
fi

if [ -n "${1:-}" ]; then
    TARGET="$1"
else
    TARGET=$(ls -1 "$DIR_DB_BACKUP"/dump-*.json 2>/dev/null | sort -r | head -1 || true)
    if [ -z "$TARGET" ]; then
        echo "ERROR: no dumps found in $DIR_DB_BACKUP" >&2
        echo "Run tools/db-dump first, or pass a fixture path explicitly." >&2
        exit 1
    fi
fi

if [ ! -f "$TARGET" ]; then
    echo "ERROR: no such fixture: $TARGET" >&2
    exit 1
fi

echo "================="
echo "LOAD DATA FROM $TARGET"
echo "================="

# Pass an absolute path so loaddata never resolves the name through FIXTURE_DIRS and
# quietly restores the repo's frozen test fixture instead of the user's real backup.
"$PY" src/web/manage.py loaddata "$(cd "$(dirname "$TARGET")" && pwd)/$(basename "$TARGET")"

echo "DONE"
