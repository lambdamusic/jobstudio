#!/usr/bin/env bash
#
# Copy this to `db-bootstrap` (gitignored — keep real creds out of git),
# fill in real values, then run it.

# The interpreter. `tools/py` is generated by `jobstudio init` and gitignored,
# because the path is personal to this machine (plan §3.3). $JOBSEARCH_PY overrides it.
PY="${JOBSEARCH_PY:-$(cd "$(dirname "$0")" && pwd)/py}"
if [ ! -x "$PY" ]; then
    echo "tools/py not found. Run \`/jobstudio init\`, or set \$JOBSEARCH_PY." >&2
    exit 1
fi

cd "$(dirname "$0")/.."

"$PY" src/web/manage.py makemigrations
"$PY" src/web/manage.py migrate

echo "from django.contrib.auth.models import User; User.objects.create_superuser('NAME', 'EMAIL', 'PASSWORD')" | "$PY" src/web/manage.py shell

echo "SUPERUSER CREATED: 'NAME'"
