#!/usr/bin/env bash
#
# Rebuild example-data/backups/django/dump.json from the example files + _fixture_rows.py.
#
# The fixture is generated through the real models in a THROWAWAY data root, never
# by hand and never against anyone's real database. That gives two things hand-written
# JSON cannot: it is valid against the current models by construction, and when the
# models change you re-run this instead of editing JSON by hand.
#
# Deliberately excluded from the dump:
#   contenttypes, auth.permission   created by `migrate`; including them makes loaddata
#                                   fail with a UNIQUE constraint error on restore
#   sessions                        ephemeral
#   auth.user, admin.logentry       the real repo's dump carries these, and auth.user
#                                   carries a password hash. The example ships neither:
#                                   the test suite creates its own superuser, so nothing
#                                   needs them, and a public repo must not contain a
#                                   credential hash even a synthetic one.
set -euo pipefail

cd "$(dirname "$0")/.."
REPO="$PWD"
# The interpreter. `tools/py` is generated by `jobstudio init` and gitignored,
# because the path is personal to this machine (plan §3.3). $JOBSEARCH_PY overrides it.
PY="${JOBSEARCH_PY:-$(cd "$(dirname "$0")" && pwd)/py}"
if [ ! -x "$PY" ]; then
    echo "tools/py not found. Run \`/jobstudio init\`, or set \$JOBSEARCH_PY." >&2
    exit 1
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
cp -R example-data/jobs "$TMP"/
cp example-data/config.yaml "$TMP"/ 2>/dev/null || true
mkdir -p "$TMP/exports" "$TMP/backups/django"

export JOBSTUDIO_DATA="$TMP"
echo "building in throwaway data root: $TMP"

"$PY" src/web/manage.py migrate --no-input >/dev/null
"$PY" src/web/manage.py import_jobs --quiet
"$PY" src/web/manage.py shell < example-data/_fixture_rows.py

OUT="$REPO/example-data/backups/django/dump.json"
"$PY" src/web/manage.py dumpdata \
    --exclude contenttypes \
    --exclude auth.permission \
    --exclude sessions \
    --exclude auth.user \
    --exclude admin.logentry \
    --indent 2 > "$OUT"

echo "wrote $OUT"
"$PY" - "$OUT" <<'PYCHECK'
import json, sys, collections
d = json.load(open(sys.argv[1]))
print(f"  {len(d)} objects:", dict(collections.Counter(o['model'] for o in d)))
assert not any(o['model'] in ('auth.user', 'admin.logentry') for o in d), "credential data leaked into the example fixture"
assert not any('michele' in json.dumps(o).lower() or 'pasin' in json.dumps(o).lower() for o in d), "real identity leaked into the example fixture"
print("  checks passed: no auth.user, no admin.logentry, no real identity")
PYCHECK
