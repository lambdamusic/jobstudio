#!/usr/bin/env bash
#
# Render the site to static HTML in site/.
#
# Replaces the runserver + wget --mirror step: Django's test client renders every page
# in-process, so this needs no server, no port, and takes ~2s instead of ~1min. Every
# internal link in the output is verified before the build is accepted.
#
# Usage: tools/site-build [--output DIR] [--clean]

# The interpreter. `tools/py` is generated by `jobstudio init` and gitignored,
# because the path is personal to this machine (plan §3.3). $JOBSEARCH_PY overrides it.
PY="${JOBSEARCH_PY:-$(cd "$(dirname "$0")" && pwd)/py}"
if [ ! -x "$PY" ]; then
    echo "tools/py not found. Run \`/jobstudio init\`, or set \$JOBSEARCH_PY." >&2
    exit 1
fi

set -e
cd "$(dirname "$0")/.."

"$PY" src/web/manage.py import_jobs --quiet
"$PY" src/web/manage.py build_static "$@"
