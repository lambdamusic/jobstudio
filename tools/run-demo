#!/usr/bin/env bash
#
# Run the web app against the repo's example data, in a throwaway data root.
#
# For screen recordings (docs/images/quick-intro.gif), for showing someone the app
# without showing them a real job search, and for eyeballing a UI change against data
# that is the same on every machine.
#
# The whole trick is $JOBSTUDIO_DATA: local_settings.py derives DATA_ROOT from
# config.data_root(), and the sqlite path from DATA_ROOT — so one variable moves the
# database and the files on disk together. Point it at a copy of example-data/ and the
# app is fully populated with Alex Rivera / Grafana Labs, while the real data root is
# never opened.
#
# Why a copy, and not example-data/ itself: `migrate` would turn the tracked 0-byte
# example-data/db.sqlite3 placeholder into a real database inside the repo. Gitignored,
# so it would not ship — but it would sit in the working tree and drift from the
# fixture. Same reason tools/build-example-fixture builds in a temp root.
#
# Port 8011, not run-dev-local-db's default 8010, so a demo can never be mistaken for —
# or collide with — a session pointed at real data.
#
# Usage:
#   tools/run-demo                # rebuild the demo root, then serve on 8011
#   tools/run-demo --keep         # serve what is already there, no rebuild
#   tools/run-demo 8012           # another port
#
# $JOBSTUDIO_DEMO_ROOT overrides where the throwaway root lives.

set -euo pipefail

# The interpreter. `tools/py` is generated by `jobstudio init` and gitignored,
# because the path is personal to this machine (plan §3.3). $JOBSEARCH_PY overrides it.
PY="${JOBSEARCH_PY:-$(cd "$(dirname "$0")" && pwd)/py}"
if [ ! -x "$PY" ]; then
    echo "tools/py not found. Run \`/jobstudio init\`, or set \$JOBSEARCH_PY." >&2
    exit 1
fi

TOOLS="$(cd "$(dirname "$0")" && pwd)"
cd "$TOOLS/.."
REPO="$PWD"

KEEP=no
PORT=8011
for arg in "$@"; do
    case "$arg" in
        --keep) KEEP=yes ;;
        [0-9]*) PORT="$arg" ;;
        -h|--help) sed -n '3,26p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown argument: $arg (try --help)" >&2; exit 1 ;;
    esac
done

DEMO="${JOBSTUDIO_DEMO_ROOT:-/tmp/jobstudio-demo}"
# Written on creation, required before any rm -rf. A real data root does not have it,
# so a mistyped $JOBSTUDIO_DEMO_ROOT costs an error message rather than a job search.
MARKER=".jobstudio-demo"

if [ "$KEEP" = yes ]; then
    [ -f "$DEMO/$MARKER" ] || {
        echo "ERROR: no demo root at $DEMO — run without --keep to build one." >&2
        exit 1
    }
    echo "reusing demo data root: $DEMO"
else
    if [ -e "$DEMO" ] && [ ! -f "$DEMO/$MARKER" ]; then
        echo "ERROR: $DEMO exists and is not a demo root (no $MARKER)." >&2
        echo "Refusing to delete it. Move it aside, or set \$JOBSTUDIO_DEMO_ROOT." >&2
        exit 1
    fi
    rm -rf "$DEMO"
    mkdir -p "$DEMO/exports" "$DEMO/backups/django"
    touch "$DEMO/$MARKER"
    cp -R example-data/jobs "$DEMO"/
    cp example-data/config.yaml "$DEMO"/
    echo "building demo data root: $DEMO"

    export JOBSTUDIO_DATA="$DEMO"
    "$PY" src/web/manage.py migrate --no-input >/dev/null
    # Absolute path, so loaddata never resolves the name through FIXTURE_DIRS
    # (same reason tools/db-load does it).
    "$PY" src/web/manage.py loaddata "$REPO/example-data/backups/django/dump.json"

    # The fixture ships no auth.user on purpose — a public repo must not carry a
    # password hash, even a synthetic one (see tools/build-example-fixture). So /admin/
    # needs a login the demo root creates for itself; it dies with the directory.
    echo "from django.contrib.auth.models import User
User.objects.filter(username='demo').exists() or User.objects.create_superuser('demo', 'demo@example.com', 'demo')" \
        | "$PY" src/web/manage.py shell >/dev/null
fi

export JOBSTUDIO_DATA="$DEMO"
echo
echo "  app:    http://127.0.0.1:${PORT}/"
echo "  admin:  http://127.0.0.1:${PORT}/admin/  (demo / demo)"
echo "  data:   $DEMO  (throwaway — your real data root is untouched)"
echo
exec "$TOOLS/run-dev-local-db" "$PORT"
