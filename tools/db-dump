#!/usr/bin/env bash
#
# Backup DB data to a portable, timestamped JSON fixture.
#
# Dumps land in <data-root>/backups/django/dump-<YYYY-MM-DD-HHMM>.json — the data root,
# not the repo, because they are this person's job search (plan §3.1). Timestamped so a
# bad dump can't destroy the last good one, which a single overwritten file invites.
#
# NOT to be confused with <repo>/backups/django/dump.json, which is the frozen fixture
# the Django test suite loads (FIXTURE_DIRS, and tests.py pins the name). That one is
# deliberately stable and is not written by this script.
#
# In the split layout nothing under the data root is version-controlled, so these dumps
# are the only real backup of applications and companies. Run after a session.
#
# The dump includes the admin account and its edit history (auth.user, admin.logentry), so
# restoring gives you a working login. Note that auth.user carries the superuser's
# password hash — which is a reason to keep the data root private.
#
# Three things stay excluded, for technical reasons rather than privacy:
#   contenttypes, auth.permission  created by `migrate`; including them makes loaddata fail
#                                  with a UNIQUE constraint error when restoring
#   sessions                       ephemeral, and worthless once the secret key changes
#
# Usage: tools/db-dump [--keep N]     (default: keep the 20 most recent)

set -euo pipefail
cd "$(dirname "$0")/.."

# The interpreter. `tools/py` is generated by `jobstudio init` and gitignored,
# because the path is personal to this machine (plan §3.3). $JOBSEARCH_PY overrides it.
PY="${JOBSEARCH_PY:-$(cd "$(dirname "$0")" && pwd)/py}"
if [ ! -x "$PY" ]; then
    echo "tools/py not found. Run \`/jobstudio init\`, or set \$JOBSEARCH_PY." >&2
    exit 1
fi

KEEP=20
if [ "${1:-}" = "--keep" ]; then KEEP="${2:?--keep needs a number}"; fi

DATA_ROOT=$("$PY" -c 'import sys; sys.path.insert(0, "src"); import config; print(config.data_root())')
DIR_DB_BACKUP="$DATA_ROOT/backups/django"
mkdir -p "$DIR_DB_BACKUP"

FILENAME="$DIR_DB_BACKUP/dump-$(date +%Y-%m-%d-%H%M).json"

echo -e "\nBACKING UP DB DATA .... TO $FILENAME"
echo "+++++++++++++++++"

"$PY" src/web/manage.py dumpdata \
    --exclude contenttypes \
    --exclude auth.permission \
    --exclude sessions \
    --indent=4 > "$FILENAME"

# A dumpdata that dies mid-write leaves a short or empty file that looks like a backup
# but restores nothing. Refuse to keep one.
if [ ! -s "$FILENAME" ]; then
    echo "ERROR: dump is empty — removing $FILENAME" >&2
    rm -f "$FILENAME"
    exit 1
fi
if ! "$PY" -c "import json,sys; json.load(open(sys.argv[1]))" "$FILENAME"; then
    echo "ERROR: dump is not valid JSON — removing $FILENAME" >&2
    rm -f "$FILENAME"
    exit 1
fi

# Prune oldest, keeping the most recent $KEEP. The timestamp format sorts lexically.
ls -1 "$DIR_DB_BACKUP"/dump-*.json 2>/dev/null | sort -r | tail -n "+$((KEEP + 1))" | while read -r old; do
    echo "  pruning $(basename "$old")"
    rm -f "$old"
done

echo -e "\nDONE: $FILENAME\n"
