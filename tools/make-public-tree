#!/usr/bin/env bash
#
# Build the public toolkit tree into a target directory (plan §6, M1.6).
#
#     tools/make-public-tree /path/to/empty/public-repo
#
# Copies only files git tracks, minus an explicit denylist, then CHECKS the result and
# refuses to leave a tree that carries personal data. It does not init, commit or push
# anything — you create the repo and decide what to do with the result.
#
# Enumerating from `git ls-files` rather than the working tree is deliberate: anything
# gitignored (db.sqlite3, tools/py, tools/env.sh, local_settings.py, the data root) is
# then excluded by construction rather than by remembering to list it.
set -euo pipefail

cd "$(dirname "$0")/.."
SRC="$PWD"
DEST="${1:-}"

[ -n "$DEST" ] || { echo "usage: tools/make-public-tree <target-dir>" >&2; exit 1; }
mkdir -p "$DEST"
[ -z "$(ls -A "$DEST" 2>/dev/null | grep -v '^\.git$' || true)" ] || {
    echo "refusing: $DEST is not empty (a .git directory is fine)" >&2; exit 1; }

# Never ships. extras/ holds third-party copyrighted PDFs.
# See backlog/m1.1-inventory.md.
# *.code-workspace is generated by `init` and holds absolute paths. It is gitignored,
# so it should never reach `git ls-files` — but this copier trusts that list, and a
# single `git add -f` upstream would be enough. Deny it explicitly rather than rely on
# the ignore rule holding forever.
#
# backlog/, log/ and CHANGELOG.md were on this list until M1.7 (2026-09-21) and are
# deliberately NOT any more: Michele's call — the planning, the migration history and the
# release history carry nothing secret and are the rationale for the code beside them. Leaving them denied would
# have been worse than either shipping or withholding them, because they now live in
# this repo: the copier would have skipped them, the checks below would have passed
# without ever reading them, and the result would have been a clean verification of a
# tree that does not match what is published. See ALLOW_NAME.
DENY='^(extras/|backups/|jobs/|exports/|site/|db\.sqlite3$|README_PRIVATE\.md$|\.vscode/)|\.code-workspace$'

echo
echo "building public tree: $SRC -> $DEST"

# Every check below reads the COPIED tree, and the copy is enumerated from `git ls-files`
# — so an uncommitted or untracked file is invisible to all of them. That is not a
# theoretical gap: on 2026-09-21 this script reported PUBLIC TREE OK on a tree whose
# newest file, still untracked at the time, carried the very employer terms the new
# PRIVATE check exists to catch. Committing it flipped the same tree to REFUSING TO SHIP.
#
# So the answer is only meaningful for committed state, and a dirty tree is refused
# rather than silently under-checked. Same failure as the backlog/log denylist (§5.7)
# and the tests.py exemption (M1.8): a verifier reporting clean on files it never read.
dirty=$(git status --porcelain --untracked-files=all | grep -Ev "^!!" || true)
if [ -n "$dirty" ]; then
    echo "REFUSING TO SHIP: uncommitted or untracked files — the checks only see committed state:" >&2
    echo "$dirty" | sed 's/^/  /' >&2
    echo "  commit (or stash) them, then re-run." >&2
    exit 1
fi

n=0
while IFS= read -r f; do
    [[ "$f" =~ $DENY ]] && continue
    mkdir -p "$DEST/$(dirname "$f")"
    cp -p "$f" "$DEST/$f"
    n=$((n+1))
done < <(git ls-files)
echo "  copied $n files"

fail() { echo "REFUSING TO SHIP: $*" >&2; exit 1; }

# Enumerating from `git ls-files` excludes gitignored files by construction — and
# silently excludes UNTRACKED ones too, which is how a brand-new LICENSE goes missing
# without anyone noticing. Name what must be present.
for f in LICENSE README.md CLAUDE.md CHANGELOG.md pyproject.toml .gitignore; do
    [ -f "$DEST/$f" ] || fail "$f is missing — is it committed? (this copies tracked files only)"
done

# --- checks -----------------------------------------------------------------
# Files EXPECTED to contain the author's name, because the literal is the thing being
# asserted (or, for LICENSE, the copyright holder). Everything else must not.
# backlog/ and log/ name the author throughout: they are signed design documents about
# *his* migration, not job-search data, and anonymising them would gut them (§5 is
# literally "Michele's own migration"). The guard exists to stop personal job-search
# CONTENT leaking, not to hide who wrote the toolkit — whose name is already on LICENSE
# and every commit.
#
# Every entry is load-bearing, and it is kept that way deliberately: M1.8 found two that
# were not. `src/appfolder.py` had carried an exemption since its hardcoded author slug
# was fixed, long after the name was gone; `tests.py` had one that let real company
# names from the author's own applications sit in a public repo unnoticed — the exact
# job-search CONTENT this check exists to catch, waved through by a comment written for
# the assert-the-name-is-absent files. An exemption no file needs is not free: it is a
# blind spot waiting for the next file that matches the path.
ALLOW_NAME='tools/smoke-test|tools/build-example-fixture|tools/make-public-tree|LICENSE|^backlog/|^log/'

# The exemption above covers the author's NAME only, and that distinction is the whole
# point of splitting the check in two. backlog/ and log/ are signed design documents, so
# a byline in them is expected — but they are also where the roadmap lives, and a roadmap
# for a job-search tool accretes job-search specifics: which employer, which competitor
# dashboard, which companies are being tracked. Found 2026-09-21, after M1.8: TODO `#19`
# named a former employer's competitive-intelligence export, and the inventory quoted the
# author's employment history employer by employer. The check below already matched some
# of those strings — the directory exemption was the only reason they were not caught.
#
# So: employer, home town and job-search content are exempt NOWHERE.
#
# The TERMS themselves live in a gitignored `.private-terms`, one per line, and not in
# this file — because the list is itself personal. A denylist naming a former employer
# discloses that employer to anyone reading it, which is how the first public push of
# this repo shipped five such terms in one line: the script was exempt from its own
# checks so that it *could* hold them, and shipping the script shipped the list.
# See `.private-terms.example`. Same move as `jobs/scan-config.yaml`: keep the
# mechanism in the repo, keep the data in files that never leave the machine.
PRIVATE_FILE="$SRC/.private-terms"
if [ -f "$PRIVATE_FILE" ]; then
    PRIVATE=$(grep -vE '^[[:space:]]*(#|$)' "$PRIVATE_FILE" | paste -sd'|' -)
else
    PRIVATE=""
fi
ALLOW_PRIVATE='tools/make-public-tree'

# The home-path check gets a SEPARATE, narrower list, and the difference is the point.
# backlog/ and log/ are exempt from the name check but NOT from this one: their absolute
# paths were scrubbed to ~/ on 2026-09-21 (M1.7) precisely so they would not need an
# exemption here. Reusing ALLOW_NAME for both — as this did until then — would mean the
# next plan document pasting a real /Users/... path ships unnoticed, which is a leak of a
# different kind from an author's byline and should not inherit the same permission.
# Only make-public-tree itself qualifies: the grep literals below are the "/Users/" it
# would otherwise report. The other four entries this list used to carry were dead — no
# file among them contains an absolute path at all (M1.8).
ALLOW_PATH='tools/make-public-tree'

hits=$(cd "$DEST" && grep -ril "michele\|pasin" . 2>/dev/null \
       | sed 's|^\./||' | grep -Ev "$ALLOW_NAME" || true)
[ -z "$hits" ] || fail $'personal identity in:\n'"$hits"

if [ -n "$PRIVATE" ]; then
    hits=$(cd "$DEST" && grep -rilE "$PRIVATE" . 2>/dev/null \
           | sed 's|^\./||' | grep -Ev "$ALLOW_PRIVATE" || true)
    [ -z "$hits" ] || fail $'employer / job-search specifics in:\n'"$hits"
else
    echo "  NOTE: no .private-terms file — employer/job-search check SKIPPED" >&2
    echo "        copy .private-terms.example to .private-terms and list your own" >&2
fi

# Same exemption, same reason: backlog/ and log/ quote the citation strings while
# recording that they were REMOVED from the shipping docs (commit 31e547b). A document
# describing the deletion of a citation is not a citation. Match on the path, so a real
# citation creeping back into subcommands/ or docs/ is still caught.
hits=$(cd "$DEST" && grep -rn "Manual pp\.\|manual pp\." . 2>/dev/null \
       | sed 's|^\./||' | grep -Ev "^(backlog/|log/|tools/make-public-tree:)" || true)
[ -z "$hits" ] || fail $'third-party manual citations:\n'"$hits"

hits=$(cd "$DEST" && grep -rl "/Users/" . 2>/dev/null | sed 's|^\./||' | grep -Ev "$ALLOW_PATH" || true)
[ -z "$hits" ] || fail $'absolute home-directory paths in:\n'"$hits"

for f in db.sqlite3 backups/django/dump.json tools/py tools/env.sh src/web/local_settings.py; do
    [ -e "$DEST/$f" ] && fail "$f was copied and must never ship"
done

"${JOBSEARCH_PY:-$SRC/tools/py}" - "$DEST" <<'PYCHECK'
import json, sys, pathlib
dest = pathlib.Path(sys.argv[1])
for p in dest.rglob("*.json"):
    try:
        d = json.loads(p.read_text())
    except Exception:
        continue
    if isinstance(d, list) and any(isinstance(o, dict) and o.get("model") in
                                   ("auth.user", "admin.logentry") for o in d):
        raise SystemExit(f"REFUSING TO SHIP: credential/admin data in {p}")
print("  no auth.user or admin.logentry in any fixture")
PYCHECK

echo "  no personal identity, no employer or job-search specifics, no manual citations, no home paths"
echo
echo "PUBLIC TREE OK — $DEST"
echo "Nothing was committed or pushed. Review it, then git init / add a remote yourself."
