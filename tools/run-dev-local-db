#!/usr/bin/env bash
# Run the Django dev server (the authoring UI).
#
# Port 8010, not the Django default 8000 — another project (wittgensteiniana) already
# runs runserver_plus on 8000. tools/site-dump mirrors from this same port.
#
# Usage: tools/run-dev-local-db [port]

# The interpreter. `tools/py` is generated by `jobstudio init` and gitignored,
# because the path is personal to this machine (plan §3.3). $JOBSEARCH_PY overrides it.
PY="${JOBSEARCH_PY:-$(cd "$(dirname "$0")" && pwd)/py}"
if [ ! -x "$PY" ]; then
    echo "tools/py not found. Run \`/jobstudio init\`, or set \$JOBSEARCH_PY." >&2
    exit 1
fi

export ENVIRONMENT=local
PORT="${1:-8010}"

cd "$(dirname "$0")/../src/web"
"$PY" manage.py runserver_plus "127.0.0.1:${PORT}"
